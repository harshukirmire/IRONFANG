# Environment files — NEVER commit secrets
.env
.env.vercel
.env.local
.env.*.local
.env.development
.env.test
.env.production
*/.env
*/.env.vercel
*/.env.local
*/.env.*.local
*.env/**

# Dependencies
node_modules/
node_modules/**
*/node_modules/
/.pnp
.pnp.js

# Build outputs
dist/
build/
/build
/dist

# Testing
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
